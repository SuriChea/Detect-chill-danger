        {
            "id": "{c646a025-3b7e-4648-abc4-b1960964b228}",
            "model": {
                "data": {
                    "auto_start": false,
                    "caption": "detect",
                    "code": "from ultralytics import YOLO\r\nimport cv2\r\n\r\nmodel = YOLO(\"yolov8n.pt\")\r\n\r\n# ค่ากลางเริ่มต้นสำหรับทดลองกับวิดีโอทั่วไป (ควรปรับตามมุมกล้องจริงอีกครั้ง)\r\nMIN_CHILD_H_RATIO = 0.25\r\nMIN_CHILD_Y2_RATIO = 0.60\r\nCONF_THRESHOLD = 0.30\r\n\r\ndef handle_request(req):\r\n\tpayload, img = getReqData(req)\r\n\t\r\n\tif img is None:\r\n\t\treturn makeRespData(payload, img)\r\n\t\t\r\n\toutput_img = img.copy()\r\n\timg_h, img_w = img.shape[:2]\r\n\t\r\n\tresults = model.predict(\r\n\t\tsource=img,\r\n\t\tconf=CONF_THRESHOLD,\r\n\t\tverbose=False\r\n\t)\r\n\t\r\n\tchild_boxes = []\r\n\tother_person_boxes = []\r\n\tknife_boxes = []\r\n\r\n\tfor box in results[0].boxes:\r\n\t\tcls_id = int(box.cls[0].cpu().numpy())\r\n\t\tcls_name = model.names[cls_id].lower()\r\n\t\t\r\n\t\tx1, y1, x2, y2 = map(int, box.xyxy[0].cpu().numpy())\r\n\t\th_ratio = (y2 - y1) / float(img_h) if img_h > 0 else 0.0\r\n\t\ty2_ratio = y2 / float(img_h) if img_h > 0 else 0.0\r\n\t\t\r\n\t\tif cls_name == \"person\":\r\n\t\t\tis_likely_child = (h_ratio >= MIN_CHILD_H_RATIO) and (y2_ratio >= MIN_CHILD_Y2_RATIO)\r\n\t\t\t\r\n\t\t\tif is_likely_child:\r\n\t\t\t\tchild_boxes.append({\"x1\": x1, \"y1\": y1, \"x2\": x2, \"y2\": y2})\r\n\t\t\t\tcv2.rectangle(output_img, (x1, y1), (x2, y2), (0, 255, 0), 2)\r\n\t\t\t\tcv2.putText(\r\n\t\t\t\t\toutput_img,\r\n\t\t\t\t\tf\"Child (h:{h_ratio:.2f}, y2:{y2_ratio:.2f})\",\r\n\t\t\t\t\t(x1, max(y1 - 10, 20)),\r\n\t\t\t\t\tcv2.FONT_HERSHEY_SIMPLEX,\r\n\t\t\t\t\t0.45,\r\n\t\t\t\t\t(0, 255, 0),\r\n\t\t\t\t\t2\r\n\t\t\t\t)\r\n\t\t\telse:\r\n\t\t\t\tother_person_boxes.append({\"x1\": x1, \"y1\": y1, \"x2\": x2, \"y2\": y2})\r\n\t\t\t\tcv2.rectangle(output_img, (x1, y1), (x2, y2), (0, 255, 255), 2)\r\n\t\t\t\tcv2.putText(\r\n\t\t\t\t\toutput_img,\r\n\t\t\t\t\tf\"Person (h:{h_ratio:.2f}, y2:{y2_ratio:.2f})\",\r\n\t\t\t\t\t(x1, max(y1 - 10, 20)),\r\n\t\t\t\t\tcv2.FONT_HERSHEY_SIMPLEX,\r\n\t\t\t\t\t0.45,\r\n\t\t\t\t\t(0, 255, 255),\r\n\t\t\t\t\t2\r\n\t\t\t\t)\r\n\t\t\t\r\n\t\telif cls_name == \"knife\" or \"knife\" in cls_name:\r\n\t\t\tknife_boxes.append({\"x1\": x1, \"y1\": y1, \"x2\": x2, \"y2\": y2})\r\n\t\t\tcv2.rectangle(output_img, (x1, y1), (x2, y2), (255, 0, 0), 2)\r\n\t\t\tcv2.putText(output_img, \"Knife\", (x1, max(y1 - 10, 20)), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 0, 0), 2)\r\n\r\n\tpayload[\"child_boxes\"] = child_boxes\r\n\tpayload[\"other_person_boxes\"] = other_person_boxes\r\n\tpayload[\"knife_boxes\"] = knife_boxes\r\n\tpayload[\"child_detected\"] = len(child_boxes) > 0\r\n\tpayload[\"knife_detected\"] = len(knife_boxes) > 0\r\n\r\n\treturn makeRespData(payload, output_img)",
                    "editor_setting": {
                        "autoComplete": {
                            "caseSensitivity": true,
