        {
            "id": "{a21fa5c4-b395-4018-8068-142305ab3229}",
            "model": {
                "data": {
                    "auto_start": false,
                    "caption": "sensor-pro",
                    "code": "import json\r\n\r\n\r\ndef _to_float(val):\r\n\tif val is None or isinstance(val, bool):\r\n\t\treturn None\r\n\ttry:\r\n\t\treturn float(val)\r\n\texcept (TypeError, ValueError):\r\n\t\treturn None\r\n\r\n\r\ndef _extract_sensor_data(raw):\r\n\tif isinstance(raw, str):\r\n\t\ttry:\r\n\t\t\traw = json.loads(raw)\r\n\t\texcept Exception:\r\n\t\t\treturn {\"value\": raw}\r\n\r\n\tif not isinstance(raw, dict):\r\n\t\treturn {}\r\n\r\n\tinner = raw.get(\"payload\", raw)\r\n\tif isinstance(inner, str):\r\n\t\ttry:\r\n\t\t\tinner = json.loads(inner)\r\n\t\texcept Exception:\r\n\t\t\treturn {\"value\": inner}\r\n\r\n\tif not isinstance(inner, dict):\r\n\t\treturn {}\r\n\r\n\tif (\r\n\t\t\"value\" in inner\r\n\t\tor \"type\" in inner\r\n\t\tor \"temperature\" in inner\r\n\t\tor \"temp\" in inner\r\n\t\tor \"humidity\" in inner\r\n\t\tor \"humi\" in inner\r\n\t):\r\n\t\treturn inner\r\n\r\n\tfor _, val in inner.items():\r\n\t\tif isinstance(val, dict) and (\r\n\t\t\t\"value\" in val\r\n\t\t\tor \"type\" in val\r\n\t\t\tor \"temperature\" in val\r\n\t\t\tor \"temp\" in val\r\n\t\t\tor \"humidity\" in val\r\n\t\t\tor \"humi\" in val\r\n\t\t):\r\n\t\t\treturn val\r\n\r\n\treturn inner\r\n\r\n\r\ndef _extract_temp_and_humi(sensor_data):\r\n\ttemp = _to_float(sensor_data.get(\"temperature\", sensor_data.get(\"temp\")))\r\n\thumi = _to_float(sensor_data.get(\"humidity\", sensor_data.get(\"humi\")))\r\n\r\n\ts_type = str(sensor_data.get(\"type\", \"\")).strip().lower()\r\n\ts_val = _to_float(sensor_data.get(\"value\"))\r\n\r\n\tif temp is None and s_val is not None and s_type in (\"temperature\", \"temp\", \"c\"):\r\n\t\ttemp = s_val\r\n\r\n\tif humi is None and s_val is not None and s_type in (\"humidity\", \"humi\", \"rh\"):\r\n\t\thumi = s_val\r\n\r\n\treturn temp, humi\r\n\r\n\r\ndef handle_request(req):\r\n\tpayload, img = getReqData(req)\r\n\r\n\tif not isinstance(payload, dict):\r\n\t\tpayload = {}\r\n\r\n\tsensor_data = _extract_sensor_data(payload)\r\n\ts_type = sensor_data.get(\"type\") or \"N/A\"\r\n\ts_val = sensor_data.get(\"value\") or \"N/A\"\r\n\r\n\ttemp, humi = _extract_temp_and_humi(sensor_data)\r\n\r\n\ttemp_out_of_range = temp is not None and (temp < 23.0 or temp > 26.0)\r\n\thumi_out_of_range = humi is not None and (humi < 45.0 or humi > 60.0)\r\n\r\n\t# แจ้งเตือนสถานะ ON เฉพาะกรณีที่ไม่ได้ส่งค่าอุณหภูมิ/ความชื้นมาใน type\r\n\ts_type_lower = str(s_type).strip().lower()\r\n\tis_on_status = (\r\n\t\tstr(s_val).upper() == \"ON\"\r\n\t\tand s_type_lower not in (\"temperature\", \"temp\", \"c\", \"humidity\", \"humi\", \"rh\")\r\n\t)\r\n\r\n\tmqtt_alert = is_on_status or temp_out_of_range or humi_out_of_range\r\n\tmessages = []\r\n\r\n\tif temp_out_of_range:\r\n\t\tmessages.append(\r\n\t\t\t\"❄️ แจ้งเตือนอุณหภูมิผิดปกติ! แนะนำให้เปิด AC\\n\"\r\n\t\t\tf\"🌡️ อุณหภูมิ: {temp:g} °C (เกณฑ์ปกติ 23 - 26 °C)\"\r\n\t\t)\r\n\r\n\tif humi_out_of_range:\r\n\t\tmessages.append(\r\n\t\t\t\"💧 แจ้งเตือนความชื้นผิดปกติ! แนะนำให้เปิดเครื่องปรับอากาศ\\n\"\r\n\t\t\tf\"💦 ความชื้น: {humi:g}% (เกณฑ์ปกติ 45 - 60%)\"\r\n\t\t)\r\n\r\n\tif is_on_status:\r\n\t\tif s_type != \"N/A\":\r\n\t\t\tmessages.append(\r\n\t\t\t\t\"🏠 อัปเดตสถานะ Smart Home\\n\"\r\n\t\t\t\tf\"🔧 ประเภท: {s_type}\\n\"\r\n\t\t\t\tf\"📌 สถานะ: {s_val}\"\r\n\t\t\t)\r\n\t\telse:\r\n\t\t\tmessages.append(\"🔔 แจ้งเตือนสถานะ: ON\")\r\n\r\n\tmqtt_message = \"\\n\\n\".join(messages)\r\n\r\n\tpayload[\"temperature\"] = temp\r\n\tpayload[\"humidity\"] = humi\r\n\tpayload[\"temp_alert\"] = temp_out_of_range\r\n\tpayload[\"humi_alert\"] = humi_out_of_range\r\n\tpayload[\"mqtt_alert\"] = mqtt_alert\r\n\tpayload[\"mqtt_message\"] = mqtt_message\r\n\tpayload[\"alert\"] = mqtt_alert\r\n\tpayload[\"message\"] = mqtt_message\r\n\r\n\treturn makeRespData(payload, img)",
