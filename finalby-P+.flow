            "id": "{9a234eb2-6ebb-4a2d-8276-e7d75b796961}",
            "model": {
                "botName": "",
                "data": {
                    "chat_id": -1,
                    "form": false,
                    "have_image": false,
                    "image_before_text": false,
                    "js_script": "// 1. ดึง raw data จาก msg หรือ payload\nvar raw = {};\nif (typeof msg !== 'undefined' && msg) {\n\traw = (msg.payload !== undefined) ? msg.payload : msg;\n} else if (typeof payload !== 'undefined') {\n\traw = payload;\n}\n\nif (typeof raw === 'string') {\n\ttry {\n\t\traw = JSON.parse(raw);\n\t} catch (e) {\n\t\traw = {};\n\t}\n}\n\n// 2. ค้นหา object ที่มี danger_alert หรือ alert / mqtt_alert ไม่ว่าจะซ้อนอยู่ชั้นไหน\nfunction findAlertObj(obj, depth) {\n\tif (!obj || typeof obj !== 'object' || depth > 4) return null;\n\tif (obj.danger_alert === true || obj.alert === true || obj.mqtt_alert === true) {\n\t\treturn obj;\n\t}\n\tfor (var key in obj) {\n\t\tif (Object.prototype.hasOwnProperty.call(obj, key)) {\n\t\t\tvar found = findAlertObj(obj[key], depth + 1);\n\t\t\tif (found) return found;\n\t\t}\n\t}\n\treturn null;\n}\n\nvar target = findAlertObj(raw, 0) || ((raw && typeof raw.payload === 'object') ? raw.payload : (raw || {}));\n\nvar isDanger = Boolean(target.danger_alert);\nvar isMqttAlert = Boolean(target.alert || target.mqtt_alert);\n\nmessage = \"\";\n\nif (isDanger) {\n\tmessage = \"🚨 แจ้งเตือนฉุกเฉิน! ตรวจพบเด็กเข้าใกล้วัตถุอันตราย (มีด) ในระยะประชิด!\";\n} else if (isMqttAlert) {\n\tif (target.message) {\n\t\tmessage = target.message;\n\t} else {\n\t\tvar sensorObj = target[\"myroom/sensor/data\"] || {};\n\t\tvar sType = target.type || sensorObj.type || \"N/A\";\n\t\tvar sVal = target.value || sensorObj.value || \"ON\";\n\t\tmessage = \"🏠 อัปเดตสถานะ Smart Home\\n🔧 ประเภท: \" + sType + \"\\n📌 สถานะ: \" + sVal;\n\t}\n}\n\n// ส่งค่าออกไปยัง msg.payload ด้วย เผื่อ TGNotify อ่านจาก msg.payload\nif (typeof msg !== 'undefined' && msg && typeof msg === 'object' && message !== \"\") {\n\tmsg.payload = message;\n}",
