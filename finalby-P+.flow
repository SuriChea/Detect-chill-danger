        {
            "id": "{8eb68b60-2896-444b-889c-c70616d34c1a}",
            "model": {
                "data": {
                    "auto_start": false,
                    "caption": "process",
                    "code": "import cv2\r\nimport numpy as np\r\n\r\ndef handle_request(req):\r\n\t# 1. ดึงข้อมูล payload และภาพเข้ามาจากโหนดด้านหน้า\r\n\tpayload, img = getReqData(req)\r\n\t\r\n\t# ป้องกัน Error กรณีภาพเป็น None\r\n\tif img is None:\r\n\t\treturn makeRespData(payload, img)\r\n\t\t\r\n\toutput_img = img.copy()\r\n\t\r\n\t# 2. รับค่าพิกัดเด็กและมีดที่ส่งมาจากโหนดหน้าสุด\r\n\tchild_boxes = payload.get(\"child_boxes\", [])\r\n\tknife_boxes = payload.get(\"knife_boxes\", [])\r\n\t\r\n\tdanger_alert = False\r\n\t\r\n\t# กำหนดระยะห่างอันตราย (หน่วยเป็นพิกเซล - ปรับเพิ่ม/ลดได้ตามมุมกล้อง)\r\n\tDANGER_DISTANCE_THRESHOLD = 500 \r\n\t\r\n\t# 3. คำนวณระยะห่าง (Euclidean Distance) ระหว่างเด็กกับมีด\r\n\tfor child in child_boxes:\r\n\t\tcx1, cy1, cx2, cy2 = child[\"x1\"], child[\"y1\"], child[\"x2\"], child[\"y2\"]\r\n\t\tchild_center_x = (cx1 + cx2) / 2\r\n\t\tchild_center_y = (cy1 + cy2) / 2\r\n\t\t\r\n\t\tfor knife in knife_boxes:\r\n\t\t\tkx1, ky1, kx2, ky2 = knife[\"x1\"], knife[\"y1\"], knife[\"x2\"], knife[\"y2\"]\r\n\t\t\tknife_center_x = (kx1 + kx2) / 2\r\n\t\t\tknife_center_y = (ky1 + ky2) / 2\r\n\t\t\t\r\n\t\t\t# คำนวณระยะทางทางเรขาคณิต\r\n\t\t\tdistance = np.sqrt((child_center_x - knife_center_x)**2 + (child_center_y - knife_center_y)**2)\r\n\t\t\t\r\n\t\t\t# 4. เช็กเงื่อนไข: ถ้าเข้าใกล้เกินระยะอันตราย\r\n\t\t\tif distance < DANGER_DISTANCE_THRESHOLD:\r\n\t\t\t\tdanger_alert = True\r\n\t\t\t\t\r\n\t\t\t\t# วาดเส้นเตือนสีแดงเชื่อมระหว่างเด็กกับมีด\r\n\t\t\t\tcv2.line(\r\n\t\t\t\t\toutput_img, \r\n\t\t\t\t\t(int(child_center_x), int(child_center_y)), \r\n\t\t\t\t\t(int(knife_center_x), int(knife_center_y)), \r\n\t\t\t\t\t(0, 0, 255), 3\r\n\t\t\t\t)\r\n\t\t\t\t\r\n\t\t\t\t# วาดข้อความแจ้งเตือนภัยบนภาพวิดีโอ\r\n\t\t\t\tcv2.putText(\r\n\t\t\t\t\toutput_img, \r\n\t\t\t\t\t\"DANGER: Child near knife!\", \r\n\t\t\t\t\t(30, 50), \r\n\t\t\t\t\tcv2.FONT_HERSHEY_SIMPLEX, \r\n\t\t\t\t\t0.8, \r\n\t\t\t\t\t(0, 0, 255), 2\r\n\t\t\t\t)\r\n\r\n\t# 5. แนบสถานะอันตรายลงใน payload เพื่อส่งต่อไปยังโหนด TGNotify\r\n\tpayload[\"danger_alert\"] = danger_alert\r\n\r\n\t# 6. ส่งภาพและ payload ที่อัปเดตแล้วกลับเข้าระบบ\r\n\tif danger_alert:\r\n\t\tpayload[\"message\"] = \"🚨 แจ้งเตือนฉุกเฉิน! ตรวจพบเด็กเข้าใกล้วัตถุอันตราย (มีด) ในระยะประชิด!\"\r\n\t\tpayload[\"alert\"] = True\r\n\telse:\r\n\t\tpayload[\"message\"] = \"\"\r\n\t\tpayload[\"alert\"] = False\r\n\r\n\tpayload[\"danger_alert\"] = danger_alert\r\n\treturn makeRespData(payload, output_img)",
